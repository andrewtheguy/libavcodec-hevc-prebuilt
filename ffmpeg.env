# The one place the version lives.
#
# `FFMPEG_COMMIT` is what actually gates the build: source.sh fetches exactly that commit from
# `FFMPEG_REPO` and asserts `git rev-parse HEAD` against it, and then asserts the tree's own
# `RELEASE` file says `FFMPEG_VERSION`, so nothing but this release ever reaches a compiler.
#
# It is FFmpeg's release tag, **unpatched**. Recompute both when bumping:
#
#   git ls-remote --tags https://github.com/FFmpeg/FFmpeg 'refs/tags/n<version>^{}'
#
# (the `^{}` line: FFmpeg's tags are annotated, and the tag object's sha is not a commit).
FFMPEG_VERSION=9.0.2
FFMPEG_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8

# A git commit rather than the `SHA256(ffmpeg-<version>.tar.xz)` FFmpeg's own release tarballs
# would allow. Those tarballs are stable and would do; the commit is used for the same reasons
# as in libde265-prebuilt and libvpx-prebuilt: it covers the whole tree, git verifies it on
# checkout, the dirty-tree check in source.sh needs a work tree to ask, and the three repositories
# then share one fetch-and-assert implementation. GitHub's mirror is fetched rather than
# git.ffmpeg.org because GitHub serves any reachable commit to a depth-1 fetch by sha.
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg

# Where the built archives are kept: the releases of a **private** repository, which
# publish-private.sh uploads to from the machines that built them and `gh` reads back for whoever
# has access — the model fdk-aac-prebuilt uses. This repository, which is public, publishes the
# source of the build; the binaries go only to collaborators. Read by publish-private.sh,
# sync-prebuilt.sh and crates/libavcodec-hevc-prebuilt-sys/build.rs, so that a fork changes this
# in one place rather than in three.
PREBUILT_REPO=andrewtheguy/libavcodec-hevc-prebuilt-archives
